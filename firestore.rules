    match /pointRequests/{requestId} {
      allow create: if isExploreStudent()
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.reason is string;
      allow read: if isTeacher() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow update: if isExploreStudent()
                    && resource.data.studentId == request.auth.uid
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['reason','status','createdAt','updatedAt']);
      allow update, delete: if isTeacher();
