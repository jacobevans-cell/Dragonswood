    match /studentSuggestions/{suggestionId} {
      allow create: if isExploreStudent()
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.status == 'new'
                    && request.resource.data.type in ['idea','change','bug','content']
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 8
                    && request.resource.data.text.size() <= 1200;
      allow read: if isTeacher()
                  || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow update, delete: if isTeacher();
    }

    match /studentSuggestionNotes/{suggestionId} {
      allow read, create, update, delete: if isTeacher();
    }

    match /focusEvents/{eventId} {
      allow create: if isExploreStudent()
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.awaySeconds is number
                    && request.resource.data.awaySeconds >= 3
                    && request.resource.data.awaySeconds <= 86400;
